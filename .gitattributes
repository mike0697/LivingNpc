# Text files are stored with LF line endings.
* text=auto eol=lf

*.bat           text eol=crlf
*.cs            text diff=csharp
*.md            text
*.json          text
*.js            text
*.mjs           text
*.jsx           text
*.css           text
*.html          text

# Unity YAML assets
*.asset         text eol=lf
*.meta          text eol=lf
*.unity         text eol=lf
*.prefab        text eol=lf
*.mat           text eol=lf
*.asmdef        text eol=lf
*.inputactions  text eol=lf
*.scenetemplate text eol=lf

# Binary files
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.psd           binary
*.wav           binary
*.mp3           binary
*.ogg           binary
*.ttf           binary
*.otf           binary
*.dll           binary
*.zip           binary
